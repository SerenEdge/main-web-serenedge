# Resend API key (https://resend.com/api-keys). serenedge.com must be a verified domain in Resend.
RESEND_API_KEY=
# Where new enquiries are delivered
CONTACT_TO_EMAIL=daham@serenedge.com
# Sender for both emails. No surrounding quotes needed — some dashboards
# (e.g. Vercel's) store the value literally, quotes included, which Resend
# then rejects. This app strips a wrapping quote pair defensively either way.
CONTACT_FROM_EMAIL=SerenEdge <sales@serenedge.com>
